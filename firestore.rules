rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Reglas para Tableros y sus Subcolecciones (cards, actionItems, etc.)
    match /boards/{boardId} {
      
      // Permitir crear si el usuario está autenticado
      allow create: if isAuthenticated();
      
      // Acceso al Tablero: El creador siempre puede, participantes si están en la lista, 
      // o todos si no hay lista de participantes (público).
      allow read, update, delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.get('participants', []).size() == 0 ||
        (request.auth.token.get('email', '') != null && request.auth.token.get('email', '').lower() in resource.data.get('participants', []))
      );
      
      // Regla Universal para Subcolecciones: 
      // Hereda la lógica de permisos del Tablero Padre mediante un get()
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/boards/$(boardId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/boards/$(boardId)).data.get('participants', []).size() == 0 ||
          (request.auth.token.get('email', '') != null && request.auth.token.get('email', '').lower() in get(/databases/$(database)/documents/boards/$(boardId)).data.get('participants', []))
        );
      }
    }
    
    // Perfiles de Usuario y Tokens FCM (Acceso privado al dueño)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      match /fcmTokens/{tokenId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
  }
}
