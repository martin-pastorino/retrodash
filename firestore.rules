rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    match /boards/{boardId} {
      allow create: if isAuthenticated();
      
      // Permitir leer, actualizar y borrar si:
      // 1. El usuario es el creador del tablero (hace posible la consulta by createdBy)
      // 2. El tablero es abierto (participants está vacío)
      // 3. El correo del usuario está en la lista de participantes (hace posible la consulta arrayContains)
      allow read, update, delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.participants.size() == 0 ||
        request.auth.token.email.lower() in resource.data.participants
      );
      
      match /cards/{cardId} {
        // Create: Secure verification against the board (O(N) initial check)
        // We enforce that the denormalized fields match the board's state.
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/boards/$(boardId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/boards/$(boardId)).data.participants.size() == 0 ||
          request.auth.token.email.lower() in get(/databases/$(database)/documents/boards/$(boardId)).data.participants
        ) && (
          request.resource.data.boardCreatorId == get(/databases/$(database)/documents/boards/$(boardId)).data.createdBy &&
          request.resource.data.boardParticipants == get(/databases/$(database)/documents/boards/$(boardId)).data.participants
        );

        // Read, Update, Delete: High performance O(1) checks using denormalized data
        // includes a fallback for legacy cards without denormalized fields
        allow read, update, delete: if isAuthenticated() && (
          resource.data.get('boardCreatorId', null) != null ? (
            resource.data.boardCreatorId == request.auth.uid ||
            resource.data.boardParticipants.size() == 0 ||
            request.auth.token.email.lower() in resource.data.boardParticipants
          ) : (
            get(/databases/$(database)/documents/boards/$(boardId)).data.createdBy == request.auth.uid ||
            get(/databases/$(database)/documents/boards/$(boardId)).data.participants.size() == 0 ||
            request.auth.token.email.lower() in get(/databases/$(database)/documents/boards/$(boardId)).data.participants
          )
        );
      }

      match /actionItems/{itemId} {
        // Create: Secure verification against the board
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/boards/$(boardId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/boards/$(boardId)).data.participants.size() == 0 ||
          request.auth.token.email.lower() in get(/databases/$(database)/documents/boards/$(boardId)).data.participants
        ) && (
          request.resource.data.boardCreatorId == get(/databases/$(database)/documents/boards/$(boardId)).data.createdBy &&
          request.resource.data.boardParticipants == get(/databases/$(database)/documents/boards/$(boardId)).data.participants
        );

        // Read, Update, Delete: High performance O(1) checks
        allow read, update, delete: if isAuthenticated() && (
          resource.data.boardCreatorId == request.auth.uid ||
          resource.data.boardParticipants.size() == 0 ||
          request.auth.token.email.lower() in resource.data.boardParticipants
        );
      }
    }

    // Reglas de Seguridad para Perfiles y Tokens FCM multidispositivo
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      match /fcmTokens/{tokenId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
  }
}

